# ============================================
# Nginx config — app.glsolutions.tech
# Sirve el frontend React compilado
# ============================================
#
# Instrucciones:
#   1. Copiar a /etc/nginx/sites-available/app.glsolutions.tech
#   2. sudo ln -s /etc/nginx/sites-available/app.glsolutions.tech /etc/nginx/sites-enabled/
#   3. sudo certbot --nginx -d app.glsolutions.tech
#   4. sudo nginx -t && sudo systemctl reload nginx
#

# Redirigir HTTP → HTTPS
server {
    listen 80;
    server_name app.glsolutions.tech;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.glsolutions.tech;

    ssl_certificate /etc/letsencrypt/live/app.glsolutions.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.glsolutions.tech/privkey.pem;

    root /home/jorge/docker/cryptoinvestor-plataforma/dist;
    index index.html;

    # Gzip para mejor performance
    gzip on;
    gzip_types text/css application/javascript text/html application/json image/svg+xml;
    gzip_min_length 256;

    # Cacheo agresivo para assets con hash
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: todas las rutas al index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
