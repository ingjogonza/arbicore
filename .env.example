# ============================================
# CryptoInvestor — Variables de Entorno
# ============================================
# Copiá este archivo a .env y completá los valores.
# En producción, usá .env.production (frontend) y
# las env vars del container Docker (backend).
# ============================================

# ── Supabase Auth (frontend + backend) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Backend API base URL (frontend) ──
# Desarrollo: http://localhost:3000
# Producción: https://api.glsolutions.tech  (se define en .env.production)
VITE_API_BASE_URL=http://localhost:3000

# ── Backend (se pasa directo al container Docker) ──
# CORS origin permitido.
# Desarrollo: http://localhost:5173
# Producción: https://app.glsolutions.tech
# Múltiples orígenes separados por coma:
#   CORS_ORIGIN=http://localhost:5173,https://app.glsolutions.tech
