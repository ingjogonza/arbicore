# ============================================
# CryptoInvestor Backend Environment Variables
# ============================================

# Public API server port (frontend-facing)
PORT=3000

# Robot API server port (mTLS only, no CORS)
ROBOT_PORT=3001

# MongoDB connection string
# Local: mongodb://localhost:27017/cryptoinvestor
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/cryptoinvestor
MONGODB_URI=mongodb://localhost:27017/cryptoinvestor

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AES-256-GCM master key — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=your-32-byte-base64-master-key-here

# CORS allowed origin(s). Múltiples orígenes separados por coma.
# Dev:      http://localhost:5173
# Prod:     https://app.glsolutions.tech
# Ambos:    http://localhost:5173,https://app.glsolutions.tech
CORS_ORIGIN=http://localhost:5173,https://app.glsolutions.tech

# mTLS certificate paths (for PR 3)
# TLS_CA_CERT=./certs/ca.crt
# TLS_SERVER_CERT=./certs/server.crt
# TLS_SERVER_KEY=./certs/server.key
